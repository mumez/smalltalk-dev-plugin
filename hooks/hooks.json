{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(*.st)",
            "command": "uv run python \"${CLAUDE_PLUGIN_ROOT}/hooks/suggest-class-comment.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.st)",
            "command": "uv run python \"${CLAUDE_PLUGIN_ROOT}/hooks/suggest-class-comment.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}

